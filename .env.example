# CaseBridge Environment Configuration Template
# Copy this file to .env or backend/.env and update the values for your deployment.

# ==============================================================================
# Backend Server Configuration
# ==============================================================================
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./casebridge.db

# Environment mode: 'dev' or 'prod'
# In 'dev', an unset JWT_SECRET falls back to a development secret.
# In 'prod', JWT_SECRET must be explicitly set or startup will fail.
ENV=dev

# Secret key for signing JWT bearer tokens (REQUIRED in production)
JWT_SECRET=replace-with-a-secure-random-secret-in-production

# Enable/disable mock login & demo credentials endpoint (default: false in production)
# When true: /auth/mock-login is enabled (except administrator), and /auth/demo-accounts reveals demo accounts.
ALLOW_DEMO_LOGIN=true

# Auto-seed demo data on startup if cases table is empty (default: false)
AUTO_SEED=false

# Comma-separated list of allowed CORS origins for web clients
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ==============================================================================
# Demo & Seed Credentials (Optional overrides for evaluation accounts)
# ==============================================================================
DEMO_ADMIN_PASSWORD=replace-with-secure-admin-password
DEMO_COORDINATOR_PASSWORD=replace-with-secure-coordinator-password
DEMO_OFFICER_PASSWORD=replace-with-secure-officer-password
DEMO_MANAGEMENT_PASSWORD=replace-with-secure-management-password

# ==============================================================================
# Frontend Environment Configuration (Vite)
# ==============================================================================
VITE_API_URL=http://localhost:8000
