# CaseBridge Environment Configuration Template
# Copy this file to .env or backend/.env and update the values for your deployment.

# ==============================================================================
# Backend Server Configuration
# ==============================================================================
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./casebridge.db

# Environment mode: 'dev' or 'prod'
# In 'dev', an unset JWT_SECRET falls back to a development secret.
# In 'prod', JWT_SECRET must be explicitly set or startup will fail.
ENV=dev

# Secret key for signing JWT bearer tokens (REQUIRED in production)
JWT_SECRET=replace-with-a-secure-random-secret-in-production

# Enable/disable mock login & demo credentials endpoint (default: false in production)
# When true: /auth/mock-login is enabled (except administrator), and /auth/demo-accounts reveals demo accounts.
ALLOW_DEMO_LOGIN=true

# Auto-seed demo data on startup if cases table is empty (default: false)
AUTO_SEED=false

# Comma-separated list of allowed CORS origins for web clients
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ==============================================================================
# Email Notification Configuration (CaseBridge Demo)
# ==============================================================================
# CaseBridge dispatches demonstration emails for complaint registration and status updates.
# Delivery is asynchronous (FastAPI BackgroundTasks) and fail-soft (failures log safely and never abort requests).
#
# Supported providers:
# - 'resend' (default HTTPS provider; recommended on Render Free where outbound SMTP ports 25/465/587 are blocked)
# - 'smtp'   (standard SMTP; kept as an explicitly selected option for compatible hosting environments)
#
# If no provider is configured, or required credentials/sender are missing, email
# delivery is skipped safely with a clear, non-secret informational log notice.
EMAIL_BACKEND=resend

# Sender information (REQUIRED to send; must be a provider-verified sender address you control)
# Leave EMAIL_FROM_EMAIL empty to safely skip outbound email delivery during local development.
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=CaseBridge Demo

# --- Resend HTTPS Provider Configuration (when EMAIL_BACKEND=resend) ---
# Sign up at https://resend.com, verify your sender domain/email, and generate an API key.
RESEND_API_KEY=

# --- SMTP Provider Configuration (when EMAIL_BACKEND=smtp) ---
# Note: Render Free blocks outbound SMTP ports 25, 465, and 587. Use only on compatible hosting.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
SMTP_TIMEOUT=10

# ==============================================================================
# Demo & Seed Credentials (Optional overrides for evaluation accounts)
# ==============================================================================
DEMO_ADMIN_PASSWORD=replace-with-secure-admin-password
DEMO_COORDINATOR_PASSWORD=replace-with-secure-coordinator-password
DEMO_OFFICER_PASSWORD=replace-with-secure-officer-password
DEMO_MANAGEMENT_PASSWORD=replace-with-secure-management-password

# ==============================================================================
# Frontend Environment Configuration (Vite)
# ==============================================================================
VITE_API_URL=http://localhost:8000
